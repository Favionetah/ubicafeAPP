<?xml version="1.0" encoding="utf-8"?>
<!-- Logo de UbiCafe: taza de café dentro de un círculo verde de marca -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Círculo de fondo verde oscuro -->
    <path
        android:fillColor="#105030"
        android:pathData="M24,4 a20,20 0 1,0 0,40 a20,20 0 1,0 0,-40 z" />

    <!-- Taza (cuerpo) -->
    <path
        android:fillColor="#F4F1E8"
        android:pathData="M15,18 h18 v7 a9,9 0 0,1 -18,0 z" />

    <!-- Asa de la taza -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F4F1E8"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M33,20 h3 a5,5 0 0,1 0,10 h-3" />

    <!-- Vapor -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#C9A57A"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M19,10 q2,-3 0,-6 M24,10 q2,-3 0,-6 M29,10 q2,-3 0,-6" />
</vector>
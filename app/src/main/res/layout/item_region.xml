<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de región cafetera (Explorar) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/fondo_tarjeta_categoria"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fondo_circulo_icono"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_map_pin" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/texto_titulo"
            style="@style/TituloRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Caranavi" />

        <TextView
            android:id="@+id/texto_descripcion"
            style="@style/TextoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Región cafetalera de Bolivia" />
    </LinearLayout>
</LinearLayout>
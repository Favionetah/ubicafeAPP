<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA: Detalle de una Tostaduría (P9b)
    - Cabecera con el nombre y la región.
    - Foto hero.
    - Tarjeta crema con Descripción, Horarios, Ubicación y Contacto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include layout="@layout/barra_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero con foto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_photo_r10">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_tostaderia" />
            </FrameLayout>

            <!-- Tarjeta crema superpuesta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/fondo_arriba_redondeado"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <!-- Descripción -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_extra_bold"
                    android:text="@string/tostaderia_descripcion"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/texto_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_sans_medium"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="14sp"
                    tools:text="Tostamos en pequeños lotes para resaltar el origen de cada grano boliviano." />

                <!-- Horarios -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="20dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/tostaderia_horarios"
                            android:textColor="@color/verde_oscuro"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/texto_horarios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito_sans_medium"
                            android:textColor="@color/verde_oscuro"
                            android:textSize="14sp"
                            tools:text="Lunes a Sábado\n9:00 a.m. - 6:00 p.m." />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ubicación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="20dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_pin" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/tostaderia_ubicacion"
                            android:textColor="@color/verde_oscuro"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/texto_ubicacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito_sans_medium"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/verde_oscuro"
                            android:textSize="14sp"
                            tools:text="Zona Sopocachi, La Paz" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Contacto -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/nunito_extra_bold"
                    android:text="@string/tostaderia_contacto"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/texto_contacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_sans_medium"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="14sp"
                    tools:text="info@roc.bo" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
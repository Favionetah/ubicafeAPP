<?xml version="1.0" encoding="utf-8"?>
<!--
    ESTADO VACÍO REUTILIZABLE
    Aparece cuando una búsqueda o un filtro no deja resultados. El texto
    se fija desde el código porque el motivo cambia (no hay coincidencias,
    no hay datos para ese filtro, etc.).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedor_vacio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="40dp"
    android:paddingVertical="48dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:alpha="0.45"
        android:background="@drawable/fondo_circulo_icono"
        android:contentDescription="@null"
        android:padding="14dp"
        android:src="@drawable/ic_buscar" />

    <TextView
        android:id="@+id/texto_vacio_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/nunito_extra_bold"
        android:gravity="center"
        android:textColor="@color/texto_principal"
        android:textSize="17sp"
        tools:text="Sin resultados" />

    <TextView
        android:id="@+id/texto_vacio_detalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/nunito_sans_regular"
        android:gravity="center"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        tools:text="Prueba con otro nombre o quita los filtros." />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un punto de venta -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/fondo_blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/box_inicial"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/fondo_cuadro_color"
            android:gravity="center">

            <TextView
                android:id="@+id/texto_inicial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_sobre_verde"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="T" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texto_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="TYPICA - Achumani" />

            <TextView
                android:id="@+id/texto_barrio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Av. Costanera, Achumani" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
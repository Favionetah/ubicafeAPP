<?xml version="1.0" encoding="utf-8"?>
<!--
    ONBOARDING (P2)
    Carrusel deslizable (ViewPager2) de 3 diapositivas con puntos de
    indicador, botón "Omitir" y botón "Siguiente"/"Comenzar".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_onboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Puntos del carrusel -->
    <LinearLayout
        android:id="@+id/indicador_paginas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- Acciones: Omitir + Siguiente/Comenzar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_omitir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_sans_semi_bold"
            android:padding="8dp"
            android:text="@string/onboarding_omitir"
            android:textColor="@color/texto_tenue"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_avanzar"
            style="@style/BotonVerdePill"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de un café de especialidad dentro del detalle de una marca.
    Al tocarla se abre su Ficha de Origen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/fondo_tarjeta_categoria"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/texto_variedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extra_bold"
            android:textColor="@color/verde_oscuro"
            android:textSize="17sp"
            tools:text="GEISHA" />

        <TextView
            android:id="@+id/texto_origen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/nunito_sans_medium"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="Caranavi · 1.600 m" />

        <TextView
            android:id="@+id/texto_notas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/nunito_sans_regular"
            android:textColor="@color/texto_tenue"
            android:textSize="12sp"
            tools:text="Notas de Jazmín y Durazno" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
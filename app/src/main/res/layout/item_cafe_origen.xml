<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de un café de especialidad dentro del detalle de una marca.
    Al tocarla se abre su Ficha de Origen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/fondo_tarjeta_categoria"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/texto_variedad"
            style="@style/NombreVariedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="GEISHA" />

        <TextView
            android:id="@+id/texto_origen"
            style="@style/TextoDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Caranavi" />

        <TextView
            android:id="@+id/texto_notas"
            style="@style/TextoNotaTenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Café de altura de Bolivia" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
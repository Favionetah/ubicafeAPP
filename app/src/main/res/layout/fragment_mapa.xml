<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA MAPA (P4)
    - Encabezado: título "Mapa" + cuántos lugares tiene el censo.
    - Debajo, el estado de la ubicación de la persona, pulsable para
      pedir el permiso si falta.
    - Filtros pill: Todos, Cafeterías, Tostadurías, Productores, Puntos de venta.
    - Mapa real de OpenStreetMap (osmdroid) con marcadores por tipo.
    - Panel inferior con la información del marcador elegido.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:osmdroid="http://schemas.osmdroid.org/map"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp">

        <TextView
            android:id="@+id/texto_titulo"
            style="@style/TituloHeader"
            android:text="@string/mapa_titulo" />

        <TextView
            android:id="@+id/texto_ubicacion"
            style="@style/SubtituloHeader"
            tools:text="213 lugares del censo" />

        <TextView
            android:id="@+id/texto_mi_ubicacion"
            style="@style/SubtituloHeader"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="32dp"
            android:paddingTop="6dp"
            android:textColor="@color/verde_oscuro"
            tools:text="Ubicación no disponible · toca para activarla" />
    </LinearLayout>

    <!-- Filtros -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/fila_filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </HorizontalScrollView>

    <!-- Mapa + panel inferior -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <org.osmdroid.views.MapView
            android:id="@+id/mapa_vista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            osmdroid:tilesource="MAPNIK"
            osmdroid:zoom="13"
            osmdroid:multiTouchControls="true" />

        <!-- Panel inferior: información del marcador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="@drawable/fondo_tarjeta_categoria"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/texto_marcador_nombre"
                style="@style/TituloMarcador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="TYPICA - Achumani" />

            <TextView
                android:id="@+id/texto_marcador_tipo"
                style="@style/TextoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Cafetería de Especialidad · Tostaduría" />

            <TextView
                android:id="@+id/texto_marcador_direccion"
                style="@style/TextoMarcadorDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                tools:text="Calle 15 de Achumani, La Paz" />

            <!-- No hay fila de rating: el censo no recoge reseñas, y un
                 "4.9" fijo ahí sería un dato inventado. -->

            <Button
                android:id="@+id/btn_ver_informacion"
                style="@style/BotonVerde"
                android:layout_marginTop="12dp"
                android:text="@string/mapa_ver_informacion" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    TARJETA DE UN LUGAR DEL CENSO
    Se usa en todas las listas: cafeterías, tostadurías, productores y
    otros. Muestra siempre de qué papel se trata, porque en el censo un
    mismo lugar puede ser cafetería y tostaduría a la vez.

    No hay foto: el censo no tiene imágenes. En su lugar va el ícono del
    rol sobre un círculo de color, para que la tarjeta nunca se vea
    vacía ni rota.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/fondo_blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila principal: ícono de rol, nombre y roles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icono_rol"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/fondo_circulo_icono"
                android:contentDescription="@null"
                android:padding="9dp"
                tools:src="@drawable/ic_cafeteria" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/texto_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_extra_bold"
                    android:maxLines="1"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    tools:text="Typica" />

                <TextView
                    android:id="@+id/texto_roles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_sans_medium"
                    android:maxLines="1"
                    android:textColor="@color/cafe_accent"
                    android:textSize="13sp"
                    tools:text="Cafetería · Marca de café" />
            </LinearLayout>

            <TextView
                android:id="@+id/texto_zona"
                style="@style/BadgeZona"
                tools:text="Sur" />
        </LinearLayout>

        <!-- Dirección, solo si el censo la respondió -->
        <TextView
            android:id="@+id/texto_direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_sans_regular"
            android:maxLines="2"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            tools:text="Calle 21 de Calacoto entre avenida Costanera" />

        <!-- Datos del detalle que tenga la ficha, o la distancia -->
        <LinearLayout
            android:id="@+id/fila_pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icono_pie"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_navigation" />

            <TextView
                android:id="@+id/texto_pie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_sans_medium"
                android:maxLines="1"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="A 450 m de ti" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

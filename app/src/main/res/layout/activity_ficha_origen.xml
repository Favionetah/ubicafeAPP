<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA: Ficha de Origen de un café de especialidad (P9a)
    - Foto hero con la inicial de la variedad.
    - Tarjeta blanca con los campos de la ficha técnica.
    - Variedades declaradas en chips.
    - El censo no registró precios: en su lugar va una línea que lo explica.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include
        android:id="@+id/barra"
        layout="@layout/barra_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Hero con foto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_photo_r12">

                <TextView
                    android:id="@+id/texto_inicial_hero"
                    style="@style/HeroFichaOrigen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    tools:text="G" />
            </FrameLayout>

            <!-- Tarjeta blanca superpuesta al hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-20dp"
                android:background="@drawable/fondo_tarjeta_categoria"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Campos de la ficha -->
                <LinearLayout
                    android:id="@+id/contenedor_ficha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Variedades declaradas -->
                <TextView
                    android:id="@+id/titulo_variedades"
                    style="@style/TituloCampoFicha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ficha_campo_variedad" />

                <LinearLayout
                    android:id="@+id/fila_variedades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

            </LinearLayout>

            <!-- Aviso en lugar del precio -->
            <TextView
                android:id="@+id/texto_sin_precios"
                style="@style/TextoNotaTenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/detalle_precios_omitidos" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
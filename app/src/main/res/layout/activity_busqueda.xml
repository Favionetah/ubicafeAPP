<?xml version="1.0" encoding="utf-8"?>
<!--
    BUSQUEDA GLOBAL (P10)
    Un solo campo busca en todo el censo y los resultados se agrupan en
    secciones. Se agrupan porque "cafe" devuelve cafés de origen, marcas
    y establecimientos a la vez, y cada tipo se ve distinto: mezclarlo
    en una lista única no ayudaría a elegir.

    Las secciones que no tienen resultados se ocultan, y el bloque de
    "precios" desaparece de la app: el censo no registró ninguno.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <!-- Campo de búsqueda con cancelar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <EditText
            android:id="@+id/campo_busqueda"
            style="@style/CampoBusqueda"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/fondo_buscador"
            android:drawableStart="@drawable/ic_buscar"
            android:drawablePadding="10dp"
            android:hint="@string/buscar_global"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp" />

        <TextView
            android:id="@+id/btn_cancelar"
            style="@style/BotonEnlaceVerde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="8dp"
            android:text="@string/buscar_cancelar" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Antes de escribir: qué se puede buscar -->
            <TextView
                android:id="@+id/texto_vacio_inicial"
                style="@style/TextoVacioBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:paddingHorizontal="40dp"
                android:text="@string/buscar_vacio_inicial" />

            <!-- Secciones de resultados -->
            <TextView
                android:id="@+id/titulo_cafes"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="Cafés de especialidad (4)"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/lista_cafes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/titulo_marcas"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Marcas registradas (2)"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/lista_marcas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/titulo_establecimientos"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Establecimientos (5)"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/lista_establecimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/titulo_productores"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/lista_productores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/titulo_tostaderias"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/lista_tostaderias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Sin coincidencias -->
            <TextView
                android:id="@+id/texto_sin_resultados"
                style="@style/TituloSinResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:paddingHorizontal="40dp"
                android:text="@string/buscar_sin_resultados_titulo"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

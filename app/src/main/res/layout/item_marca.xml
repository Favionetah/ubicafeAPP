<?xml version="1.0" encoding="utf-8"?>
<!--
    TARJETA DE UNA MARCA (P13)
    Una marca es una empresa, no un lugar: puede tener 11 locales o
    ninguno. La tarjeta muestra su inicial (el censo no tiene logotipos),
    cuántas sucursales registró y en qué zonas están.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/fondo_blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/texto_inicial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fondo_circulo_icono"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/fondo_blanco"
            android:textSize="20sp"
            tools:text="T" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texto_nombre"
                style="@style/NombreItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Typica" />

            <TextView
                android:id="@+id/texto_etiquetas"
                style="@style/DetalleItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_sans_medium"
                android:maxLines="1"
                android:textSize="13sp"
                tools:text="7 sucursales · Sur · Centro" />
        </LinearLayout>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/texto_tenue" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de un resultado de búsqueda -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/texto_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_extra_bold"
        android:maxLines="1"
        android:textColor="@color/texto_principal"
        android:textSize="15sp"
        tools:text="TYPICA - Achumani" />

    <TextView
        android:id="@+id/texto_subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_sans_medium"
        android:maxLines="2"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp"
        tools:text="Av. Costanera, Achumani · Cafetería" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divisor" />
</LinearLayout>
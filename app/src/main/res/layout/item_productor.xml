<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de un productor (P11).
    Nombre + ubicación, badge con la cantidad de cafés y enlace "Ficha técnica".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/fondo_tarjeta_categoria"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Nombre, ubicación y badge de conteo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texto_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extra_bold"
                android:maxLines="1"
                android:textColor="@color/verde_oscuro"
                android:textSize="18sp"
                tools:text="Finca El Condor" />

            <TextView
                android:id="@+id/texto_subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_sans_medium"
                android:maxLines="1"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Caranavi, La Paz" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_conteo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/fondo_badge_conteo"
            android:fontFamily="@font/nunito_bold"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/cafe_accent"
            android:textSize="12sp"
            tools:text="3 cafés" />
    </LinearLayout>

    <!-- Pie: distintivo de origen + enlace a la ficha técnica -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_sans_medium"
            android:text="@string/productores_productor_origen"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/accion_ficha_tecnica"
            android:textColor="@color/verde_oscuro"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</LinearLayout>
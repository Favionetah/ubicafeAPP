<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHA DE UN LUGAR DEL CENSO (P7)
    Una sola plantilla para cafeterías, tostadurías y productores, porque
    en el censo un mismo lugar puede cumplir varios papeles y su ficha
    tiene bloques distintos según cuáles respondió.

    Los bloques se rellenan desde el código y se ocultan cuando el lugar
    no respondió esa sección. Nunca se rellenan con datos inventados:
    no hay precios, ni estrellas, ni reseñas en el censo.

    Arriba va una foto grande del local y, justo debajo, el botón de
    cómo llegar, que es lo que la persona vino a hacer. Si el lugar no
    tiene foto, la imagen se oculta y el encabezado sube, para no dejar
    un rectángulo vacío.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include
        android:id="@+id/barra"
        layout="@layout/barra_titulo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto grande del local. Es genérica, no una foto del
                 negocio: el aviso de abajo lo dice. -->
            <ImageView
                android:id="@+id/foto_hero"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@drawable/ic_cafeteria"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/texto_foto_credito"
                style="@style/TextoNotaTenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/foto_no_es_del_local"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

            <!-- Encabezado: ícono de rol, nombre y roles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icono_rol"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/fondo_circulo_icono"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    tools:src="@drawable/ic_cafeteria" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/texto_nombre"
                        style="@style/SubtituloHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/texto_principal"
                        android:textSize="22sp"
                        tools:text="Café Berna" />

                    <TextView
                        android:id="@+id/texto_roles"
                        style="@style/EtiquetaRol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        tools:text="Cafetería · Tostaduría" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cómo llegar: lo primero que se pincha al llegar aquí.
                 Va arriba y a todo el ancho porque es la acción por la
                 que se abre una ficha de un local, no un detalle más
                 abajo. Se oculta si el lugar no tiene coordenadas,
                 porque sin destino no hay ruta que dibujar. -->
            <Button
                android:id="@+id/btn_como_llegar"
                style="@style/BotonVerde"
                android:layout_marginTop="18dp"
                android:text="@string/como_llegar"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <!-- Datos clave: zona, dirección, distancia -->
            <LinearLayout
                android:id="@+id/bloque_tecnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/dato_zona"
                    layout="@layout/item_dato" />

                <include
                    android:id="@+id/dato_direccion"
                    layout="@layout/item_dato" />

                <include
                    android:id="@+id/dato_distancia"
                    layout="@layout/item_dato" />

                <include
                    android:id="@+id/dato_tipo"
                    layout="@layout/item_dato" />
            </LinearLayout>

            <!-- Aviso del censo sobre la posición del lugar -->
            <TextView
                android:id="@+id/texto_aviso_ubicacion"
                style="@style/AvisoDelCenso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_aviso"
                android:drawablePadding="10dp"
                android:padding="14dp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_ubicacion"
                tools:text="Aviso del censo: la coordenada fue aproximada por quien respondió."
                tools:visibility="visible" />

            <!-- Fichas de detalle, una por sección respondida -->
            <TextView
                android:id="@+id/texto_titulo_fichas"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/detalle_ficha_tecnica" />

            <LinearLayout
                android:id="@+id/contenedor_fichas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- El censo no registró precios: se explica en vez de callar -->
            <TextView
                android:id="@+id/texto_sin_precios"
                style="@style/TextoNotaTenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/detalle_precios_omitidos"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/texto_registro"
                style="@style/TextoNotaTenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                tools:text="Registrado en el censo 2026" />

            <!-- Acciones secundarias -->
            <LinearLayout
                android:id="@+id/bloque_acciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_ver_mapa"
                    style="@style/BotonVerde"
                    android:text="@string/detalle_volver_mapa" />

                <Button
                    android:id="@+id/btn_ir_marca"
                    style="@style/BotonVerde"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    tools:text="Ver la cadena" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botón fijo para que sea fácil de pulsar al desplazar. -->
    <LinearLayout
        android:id="@+id/contenedor_boton_fijo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_crema"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_como_llegar_fijo"
            style="@style/BotonVerde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/como_llegar"
            app:icon="@drawable/ic_navigation"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />
    </LinearLayout>
</LinearLayout>

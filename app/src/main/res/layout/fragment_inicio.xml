<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA DE INICIO (P3)
    1. Cabecera: saludo + título.
    2. Buscador (pill).
    3. Explora por categoría (3 tarjetas en una fila).
    4. Cerca de ti (tarjeta destacada).
    5. Explora por macrodistrito (chips).
    6. Banner de productores (CTE al final).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ============ 1. CABECERA ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextoSaludo"
            android:layout_marginHorizontal="20dp"
            android:text="@string/inicio_saludo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TituloPantallaGrande"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/inicio_titulo" />

        <!-- ============ 2. BUSCADOR ============ -->
        <LinearLayout
            android:id="@+id/buscador_inicio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_buscador"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_buscar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                style="@style/CampoBusqueda"
                android:fontFamily="@font/nunito_sans_medium"
                android:text="@string/inicio_buscar_placeholder"
                android:textColor="@color/texto_tenue" />
        </LinearLayout>

        <!-- ============ 3. EXPLORA POR CATEGORÍA ============ -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/inicio_explora" />

        <!-- Fila única con las 3 categorías -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_cafeterias"
                style="@style/TarjetaCategoria3">
                <TextView
                    style="@style/TextoNombreCategoria3"
                    android:text="@string/categoria_cafeterias" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_marcas"
                style="@style/TarjetaCategoria3">
                <TextView
                    style="@style/TextoNombreCategoria3"
                    android:text="@string/categoria_marcas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_tostaderias"
                style="@style/TarjetaCategoria3">
                <TextView
                    style="@style/TextoNombreCategoria3"
                    android:text="@string/categoria_tostaderias" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TituloSeccion"
            android:text="@string/inicio_cerca_de_ti" />

        <!-- ============ 4. CERCA DE TI ============ -->
        <LinearLayout
            android:id="@+id/card_cerca_de_ti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/fondo_tarjeta_categoria"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Foto del local más cercano. Nace oculta: cuando no
                     hay ubicación no hay ningún local que enseñar, y
                     un marco vacío delataría que falta algo. -->
                <ImageView
                    android:id="@+id/foto_cerca"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/fondo_circulo_icono"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@drawable/ic_cafeteria"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                    android:id="@+id/texto_nombre_cerca"
                    style="@style/TituloHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/texto_tipo_cerca"
                    style="@style/TextoDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/texto_zona_cerca"
                    style="@style/BadgeZona"
                    android:layout_marginTop="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_navigation" />

                <TextView
                    android:id="@+id/texto_distancia"
                    style="@style/TextoDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_ver_informacion"
                style="@style/BotonVerde"
                android:layout_marginTop="14dp"
                android:text="@string/inicio_categoria_ver_informacion" />
        </LinearLayout>

        <!-- ============ 5. EXPLORA POR MACRODISTRITO ============ -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/inicio_macrodistritos" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/fila_macrodistritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />
        </HorizontalScrollView>

        <!-- ============ 6. BANNER DE PRODUCTORES ============ -->
        <LinearLayout
            android:id="@+id/banner_productores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_tarjeta_gradiente"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TituloBannerProductores"
                    android:text="@string/productores_banner_titulo" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_up_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextoBannerProductores"
                android:layout_marginTop="6dp"
                android:text="@string/productores_banner_descripcion" />
        </LinearLayout>

        <!-- ============ CIFRAS REALES DEL CENSO ============ -->
        <LinearLayout
            android:id="@+id/bloque_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_tarjeta_categoria"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TituloResumen"
                android:text="@string/inicio_resumen_titulo" />

            <TextView
                android:id="@+id/texto_resumen"
                style="@style/TextoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA DE INICIO (P3)
    1. Cabecera: saludo + título.
    2. Buscador (pill).
    3. Explora por categoría (grid 2x2).
    4. Cerca de ti (tarjeta destacada).
    5. Explora por macrodistrito (chips).
    6. Banner de productores (CTE al final).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ============ 1. CABECERA ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/nunito_sans_medium"
            android:text="@string/inicio_saludo"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/nunito_extra_bold"
            android:lineSpacingExtra="2dp"
            android:text="@string/inicio_titulo"
            android:textColor="@color/verde_oscuro"
            android:textSize="28sp" />

        <!-- ============ 2. BUSCADOR ============ -->
        <LinearLayout
            android:id="@+id/buscador_inicio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_buscador"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_buscar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/nunito_sans_medium"
                android:text="@string/inicio_buscar_placeholder"
                android:textColor="@color/texto_tenue"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ============ 3. EXPLORA POR CATEGORÍA ============ -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/inicio_explora" />

        <!-- Rejilla de categorías -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tile_cafeterias"
                    style="@style/TarjetaCategoria">
                    <TextView
                        style="@style/TextoNombreCategoria"
                        android:text="@string/categoria_cafeterias" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_marcas"
                    style="@style/TarjetaCategoria">
                    <TextView
                        style="@style/TextoNombreCategoria"
                        android:text="@string/categoria_marcas" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_tostaderias"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_margin="6dp"
                android:background="@drawable/fondo_tarjeta_categoria"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">
                <TextView
                    style="@style/TextoNombreCategoria"
                    android:text="@string/categoria_tostaderias" />
            </LinearLayout>
        </LinearLayout>

        <!-- Acceso a puntos de venta (fuera de la rejilla principal) -->
        <LinearLayout
            android:id="@+id/tile_puntos_venta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/fondo_tarjeta_categoria"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_sans_semi_bold"
                android:text="@string/categoria_puntos_venta"
                android:textColor="@color/texto_principal"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>

        <TextView
            style="@style/TituloSeccion"
            android:text="@string/inicio_cerca_de_ti" />

        <!-- ============ 4. CERCA DE TI ============ -->
        <LinearLayout
            android:id="@+id/card_cerca_de_ti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/fondo_tarjeta_categoria"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/texto_nombre_cerca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extra_bold"
                        android:textColor="@color/verde_oscuro"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/texto_tipo_cerca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito_sans_medium"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/texto_zona_cerca"
                    style="@style/BadgeZona"
                    android:layout_marginTop="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_navigation" />

                <TextView
                    android:id="@+id/texto_distancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/nunito_sans_medium"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/texto_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/nunito_sans_medium"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_ver_informacion"
                style="@style/BotonVerde"
                android:layout_marginTop="14dp"
                android:text="@string/inicio_categoria_ver_informacion" />
        </LinearLayout>

        <!-- ============ 5. EXPLORA POR MACRODISTRITO ============ -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/inicio_macrodistritos" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/fila_macrodistritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />
        </HorizontalScrollView>

        <!-- ============ 6. BANNER DE PRODUCTORES ============ -->
        <LinearLayout
            android:id="@+id/banner_productores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_tarjeta_gradiente"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_extra_bold"
                    android:text="@string/productores_banner_titulo"
                    android:textColor="@color/fondo_blanco"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_up_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunito_sans_regular"
                android:lineSpacingExtra="2dp"
                android:text="@string/productores_banner_descripcion"
                android:textColor="#E8E4D8"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
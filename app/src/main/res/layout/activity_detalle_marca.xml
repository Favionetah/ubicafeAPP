<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHA DE UNA MARCA (P7)
    Una marca es una empresa, no un lugar: la ficha muestra los datos que
    registró la empresa y, debajo, los locales que el censo encontró
    abiertos. Si no registró ninguno, se dice con todas sus letras.

    Arriba va la foto de la marca y, detrás, su inicial, que es lo que se
    ve si no hay imagen. El censo no trae logotipos, así que no se
    inventa ninguno.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include
        android:id="@+id/barra"
        layout="@layout/barra_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/foto_hero"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@drawable/ic_marca"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/texto_inicial"
                    style="@style/InicialMarca"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/fondo_circulo_icono"
                    android:textSize="26sp"
                    tools:text="T" />

                <TextView
                    android:id="@+id/texto_nombre"
                    style="@style/SubtituloHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/texto_principal"
                    android:textSize="22sp"
                    tools:text="Typica" />
            </LinearLayout>

            <TextView
                android:id="@+id/texto_nota"
                style="@style/AvisoDelCenso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fondo_aviso"
                android:padding="14dp"
                android:visibility="gone"
                tools:text="Cadena boliviana con 11 locales registrados."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/texto_titulo_datos"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/marca_datos_empresa" />

            <LinearLayout
                android:id="@+id/contenedor_datos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/texto_titulo_sucursales"
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                tools:text="11 sucursales registradas" />

            <LinearLayout
                android:id="@+id/contenedor_sucursales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_ver_mapa"
                style="@style/BotonVerde"
                android:layout_marginTop="20dp"
                android:text="@string/marca_ver_puntos_mapa" />

            <TextView
                android:id="@+id/texto_registro"
                style="@style/TextoNotaTenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                tools:text="Registrado en el censo 2026" />

            <!-- Las licencias CC BY y CC BY-SA obligan a que el autor
                 y la licencia sean accesibles desde la app. -->
            <TextView
                android:id="@+id/enlace_creditos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/creditos_abrir"
                android:textColor="@color/verde_oscuro"
                android:textSize="13sp"
                android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

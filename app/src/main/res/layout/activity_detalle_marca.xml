<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA: Detalle de una Marca (P8)
    - Cabecera con el nombre de la marca y el subtítulo "Marca nacional registrada".
    - Etiquetas de la marca como chips.
    - Cafés de Origen (abren la Ficha de Origen).
    - "¿Dónde encontrar la marca?" + botón "Ver puntos en mapa".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include layout="@layout/barra_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Etiquetas de la marca -->
            <LinearLayout
                android:id="@+id/fila_etiquetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal" />

            <!-- Sección: cafés de especialidad de la marca -->
            <TextView
                style="@style/TituloSeccion"
                android:text="@string/marca_cafes_origen" />

            <LinearLayout
                android:id="@+id/contenedor_cafes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:orientation="vertical" />

            <!-- Sección: dónde encontrar la marca -->
            <TextView
                style="@style/TituloSeccion"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="@string/marca_donde_encontrar" />

            <TextView
                android:id="@+id/texto_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/nunito_sans_regular"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                tools:text="TYPICA cuenta con 3 puntos de venta y cafeterías en la ciudad de La Paz." />

            <Button
                android:id="@+id/btn_ver_puntos_mapa"
                style="@style/BotonVerde12"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:text="@string/marca_ver_puntos_mapa"
                android:drawableStart="@drawable/ic_route" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
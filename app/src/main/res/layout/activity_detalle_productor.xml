<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla: Detalle de un Productor (finca cafetalera)
    - Encabezado con nombre de finca y familia.
    - Cifras: cafés, altitud.
    - Descripción.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include layout="@layout/barra_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/texto_finca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_principal"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Finca El Cóndor" />

            <TextView
                android:id="@+id/texto_familia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp"
                tools:text="Familia Mamani" />

            <TextView
                android:id="@+id/texto_origen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/verde_oscuro"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Caranavi, La Paz" />

            <!-- Cifras de la finca -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <LinearLayout
                    android:id="@+id/box_cifra_cafes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="6dp"
                    android:background="@drawable/fondo_tarjeta_categoria"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/texto_num_cafes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_principal"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/texto_etiqueta_cafes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp"
                        tools:text="3 cafés" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/box_cifra_altitud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="6dp"
                    android:background="@drawable/fondo_tarjeta_categoria"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/texto_num_altitud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_principal"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="1.600 m" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ficha_campo_altitud"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Descripción -->
            <TextView
                android:id="@+id/texto_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                tools:text="Productor de origen de las laderas del río Yara." />

            <TextView
                android:id="@+id/texto_rol_productor"
                style="@style/TituloSeccion"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:text="@string/productores_productor_origen" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
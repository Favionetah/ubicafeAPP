    <string name="explorar_guia_card1_titulo">¿Qué es el café de especialidad?</string>
    <string name="explorar_guia_card1_txt">Cafés con trazabilidad desde la finca, producción artesanal y cuidado en cada paso del proceso.</string>
    <string name="explorar_guia_card2_titulo">Del grano a la taza</string>
    <string name="explorar_guia_card2_txt">Recolección, despulpado, fermentación, lavado, secado y tostado: cada paso define el sabor final del café.</string>
    <string name="explorar_guia_card3_titulo">Cómo comprar café paceño</string>
    <string name="explorar_guia_card3_txt">Busca el origen, la altura y la fecha de tueste. El café de La Paz destaca por sus notas florales y cítricas.</string>
